# ─────────────────────────────────────────────
# Patient PA Assistant — Backend Config
# Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# LLM Provider — plug in your key here
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Which Claude model to use
# Options: claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001
LLM_MODEL=claude-sonnet-4-6

# Temperature for generation (0.0 = deterministic, 0.7 = creative)
LLM_TEMPERATURE=0.3

# Embeddings: "local" (sentence-transformers, no key needed) or "openai"
EMBEDDING_PROVIDER=local

# ChromaDB local path
CHROMA_DB_PATH=./chroma_db

# Policy PDFs directory
POLICY_PDF_DIR=./data/policies

# Retrieval settings
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# CORS - set to your frontend URL in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
PORT=8000
